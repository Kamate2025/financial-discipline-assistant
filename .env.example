# Django environment variables for the FD project.
#
# Copy this file to .env and adjust the values for your environment.
# Never commit .env to version control. This example file contains only
# placeholder values and explanations - no real secrets.

# Secret key used for cryptographic signing.
# Generate a unique value for every deployment (for example with Django's
# get_random_secret_key utility) and keep it private.
DJANGO_SECRET_KEY=your-secret-key-here

# Set to True for local development and False in production.
# When this is False, DJANGO_SECRET_KEY must be provided explicitly.
DJANGO_DEBUG=True

# Comma-separated list of host/domain names the Django project can serve.
# Leave empty for local development.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Service credential used by the WhatsApp (Node.js) service to authenticate
# to the Django backend. Generate a strong random value and keep it private.
# The same value must be configured in the WhatsApp service environment.
DJANGO_SERVICE_KEY=your-service-key-here

# Base URL of the Django backend, used by the WhatsApp service when calling
# the API (for example http://127.0.0.1:8000).
DJANGO_BASE_URL=http://127.0.0.1:8000

# Database
# SQLite is used for local development. PostgreSQL is planned for production
# and will be configured when the project is deployed to
# fd.kamategroup.online. No production database credentials belong here.